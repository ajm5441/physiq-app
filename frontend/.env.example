# Copy this file to .env and fill in values for your environment.
# All VITE_ prefixed variables are bundled into the browser build.
# Never put secrets in VITE_ variables — they are public.

# URL of the Flask relay server.
# In development, Vite's proxy handles this — leave empty or set to
# the relay's address if you're not using the Vite proxy.
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  PhysIQ · Environment Variables
#  Copy to .env and fill in values before running docker compose up.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (CHANGE THESE BEFORE ANY DEPLOYMENT) ────────────────────────────

# Secret used to sign all JWTs. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-deploying

# ── Service URLs ──────────────────────────────────────────────────────────────

# Origin the relay will accept CORS requests from.
# In production: set this to your actual frontend domain.
FRONTEND_ORIGIN=http://localhost:3000

# ── Optional: Redis ───────────────────────────────────────────────────────────

# If set, the relay uses Redis for session state instead of in-memory dict.
# Recommended for production so sessions survive relay restarts.
# Format: redis://[:password]@host:port/db
# Leave empty to use the in-memory fallback (fine for local development).
REDIS_URL=

# ── Optional: Google Cloud (production only) ──────────────────────────────────

# Cloud SQL connection string — replace the Docker Compose MySQL URL.
# Format: mysql+pymysql://user:pass@/dbname?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE
# DATABASE_URL=mysql+pymysql://physiq:YOURPASSWORD@/physiq?unix_socket=/cloudsql/your-project:us-central1:physiq
